PROJECT_NAME=Tonic API
ENVIRONMENT=local
DEBUG=true
BACKEND_CORS_ORIGINS=[]
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Database — `DB_SERVER=postgres` is correct when running via docker-compose
# (`postgres` is the service name). Change to `localhost` for local-only dev.
DB_SERVER=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tonic_api_db

# JWT auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-real-deployments-this-is-just-a-dev-default-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Redis — APQ hash store. `redis` is the service name in docker-compose.
REDIS_URL=redis://redis:6379/0

# GraphQL query-shape limits (defense-in-depth against DoS).
# Depth/alias/token reject malicious query shapes before execution.
# MAX_PAGE_SIZE caps Relay `first`/`last` and offset `pageSize`.
# MAX_REQUEST_BYTES rejects oversized POST bodies (413) before JSON parse.
MAX_QUERY_DEPTH=10
MAX_QUERY_ALIASES=15
MAX_QUERY_TOKENS=1500
MAX_PAGE_SIZE=50
MAX_REQUEST_BYTES=100000

# Rate limiting (Redis-backed token bucket; cost = computed query complexity).
# CAPACITY = max burst; REFILL_PER_SECOND = sustained cost/sec.
# MAX_QUERY_COMPLEXITY rejects a single query whose computed cost exceeds it.
# Key: rl:u:{user_id} if authed, else rl:ip:{client_ip}.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=1000
RATE_LIMIT_REFILL_PER_SECOND=50
MAX_QUERY_COMPLEXITY=1000
MUTATION_FLAT_COST=10

# OpenTelemetry — Phase 1: traces only.
# docker-compose already sets OTEL_ENABLED=true and the endpoint for the
# bundled collector; set OTEL_ENABLED=false to fully disable instrumentation.
# Endpoint points at the OTel Collector service (host `otel-collector` in
# the compose network); collector forwards traces to Jaeger at jaeger:4317.
# Jaeger UI: http://localhost:16686
# Sampler arg: 1.0 samples everything (good for local), drop to ~0.1 in prod.
OTEL_ENABLED=true
OTEL_SERVICE_NAME=tonic-api
OTEL_SERVICE_VERSION=0.1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_TRACES_SAMPLER_ARG=1.0
